# HarnessRouter (UHP). Leave HARNESS_MODE=mock to run fully offline with the local planner.
HARNESS_MODE=mock                # mock | real
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HR_API_KEY=                      # HarnessRouter API key (server only; never sent to the browser)
HARNESS_ID=                      # chrn_... see harnessrouter.json
HARNESS_MODEL=                   # optional per-task override; empty = the model set on the Harness

# Text-to-speech
TTS_PROVIDER=none                # openai | elevenlabs | piper | none
TTS_API_KEY=                     # optional: falls back to OPENAI_API_KEY / ELEVENLABS_API_KEY
TTS_VOICE=                       # optional; provider voice id

# App
ADMIN_TOKEN=change-me            # protects /admin
MAX_JOBS_PER_HOUR=30             # global
MAX_JOBS_PER_USER_PER_DAY=5
MAX_JOBS_PER_DAY=200             # global daily budget cap ("high demand" when hit)
MAX_CONCURRENT_JOBS=2
DATA_DIR=./data                  # /data in Docker

# Research (C19): Brave Search API key for finding problem statistics (optional)
BRAVE_API_KEY=

# Deploy tuning (containers report the host CPU count)
RENDER_CONCURRENCY=          # Remotion render workers; set to ~vCPUs on small plans
RENDER_FPS=                  # 30 halves render time; default 60
JOB_TIMEOUT_MS=              # default 600000 (10 min)
