  "scenes": [
    {
      "id": "problem",
      "section": "problem",
      "layout": "big-statement",
      "duration_s": 9.4,
      "narration": "You fill a notebook with handwriting, then your iPad breaks. The notes are gone. Your notes should live in your account, not on one device.",
      "elements": [
        {
          "type": "kinetic_headline",
          "text": "Your handwritten notes shouldn't die with your iPad",
          "animation": "word-by-word"
        }
      ],
      "transition_in": "fade"
    },
    {
      "id": "solution",
      "section": "solution",
      "layout": "big-statement",
      "duration_s": 7.3,
      "narration": "DevPad is a notebook backend that saves typed and handwritten notes to each signed-in user's account.",
      "elements": [
        {
          "type": "kinetic_headline",
          "text": "DevPad saves your notes to your account, not your device",
          "animation": "word-by-word"
        }
      ],
      "transition_in": "zoom"
    },
    {
      "id": "demo1",
      "section": "demo",
      "layout": "full-frame",
      "duration_s": 7.4,
      "narration": "This is DevPad's API running locally. Folders, notebooks, pages, cells and strokes each get their own endpoints.",
      "elements": [
        {
          "type": "clip",
          "step_id": "s1",
          "zoom": "none"
        }
      ],
      "transition_in": "push"
    },
    {
      "id": "demo2",
      "section": "demo",
      "layout": "framed-zoom",
      "duration_s": 7.6,
      "narration": "Create Notebook takes a title, folder, cover color and template. Pages then hold code, text or ink cells.",
      "elements": [
        {
          "type": "clip",
          "step_id": "s2",
          "zoom": "none"
        }
      ],
      "transition_in": "slide"
    },
    {
      "id": "demo3",
      "section": "demo",
      "layout": "framed-zoom",
      "duration_s": 3.8,
      "narration": "Try it out makes the form live, so we can send a real request.",
      "elements": [
        {
          "type": "clip",
          "step_id": "s3",
          "zoom": "none"
        }
      ],
      "transition_in": "wipe"
    },
    {
      "id": "demo4",
      "section": "demo",
      "layout": "framed-zoom",
      "duration_s": 4.1,
      "narration": "Execute sends it to the running server, with no sign-in token.",
      "elements": [
        {
          "type": "clip",
          "step_id": "s4",
          "zoom": "none"
        }
      ],
      "transition_in": "slide"
    },
    {
      "id": "demo5",
      "section": "demo",
      "layout": "framed-zoom",
      "duration_s": 9,
      "narration": "The server answers 401, not authenticated. Notebooks belong to a signed-in user: no token, no data.",
      "elements": [
        {
          "type": "clip",
          "step_id": "s5",
          "zoom": "inspect"
        }
      ],
      "transition_in": "whip"
    },
    {
      "id": "built",
      "section": "built",
      "layout": "diagram",
      "duration_s": 13.3,
      "narration": "The iPad app is written in Swift and signs in through Supabase. It sends tokens to a FastAPI backend, which stores data with SQLAlchemy in SQLite or Postgres.",
      "elements": [
        {
          "type": "diagram",
          "kind": "flow",
          "nodes": [
            {
              "id": "ios",
              "label": "iPad app (Swift)"
            },
            {
              "id": "auth",
              "label": "Supabase sign-in"
            },
            {
              "id": "api",
              "label": "FastAPI backend"
            },
            {
              "id": "orm",
              "label": "SQLAlchemy"
            },
            {
              "id": "db",
              "label": "SQLite / Postgres"
            }
          ],
          "edges": [
            {
              "from": "ios",
              "to": "auth",
              "label": "signs in"
            },
            {
              "from": "auth",
              "to": "ios",
              "label": "JWT"
            },
            {
              "from": "ios",
              "to": "api",
              "label": "requests + JWT"
            },
            {
              "from": "api",
              "to": "orm",
              "label": "queries"
            },
            {
              "from": "orm",
              "to": "db",
              "label": "reads/writes"
            }
          ]
        }
      ],
      "transition_in": "fade"
    },
    {
      "id": "next",
      "section": "next",
      "layout": "bullet-reveal",
      "duration_s": 7.9,
      "narration": "Next: typed-note editing and free placement of cells, then images and attachments, search and offline sync.",
      "elements": [
        {
          "type": "bullets",
          "items": [
            "Typed-note editing in the iPad editor",
            "Free placement of cells",
            "Images, attachments, search, offline sync"
          ],
          "animation": "slide-up"
        }
      ],
      "transition_in": "iris"
    },
    {
      "id": "ask",
      "section": "ask",
      "layout": "big-statement",
      "duration_s": 4.8,
      "narration": "Try it at github.com/yuchan-chung1964/DevPad",
      "elements": [
        {
          "type": "kinetic_headline",
          "text": "Try it at github.com/yuchan-chung1964/DevPad",
          "animation": "word-by-word"
        }
      ],
      "transition_in": "zoom"
    },
