# HarnessRouter (UHP). Leave HARNESS_MODE=mock to run fully offline with the local planner.
HARNESS_MODE=mock                # mock | real
HARNESSROUTER_BASE_URL=https://api.harnessrouter.ai
HR_API_KEY=                      # HarnessRouter API key (server only; never sent to the browser)
HARNESS_ID=                      # chrn_... see harnessrouter.json
PITCH_ROOM_ENABLED=false         # Pitch Room: 3 drafts + 1 judge (needs HARNESS_MODE=real)
HARNESS_MODEL=                   # optional per-task override; empty = the model set on the Harness

# Text-to-speech
TTS_PROVIDER=none                # openai | elevenlabs | piper | none
TTS_API_KEY=                     # optional: falls back to OPENAI_API_KEY / ELEVENLABS_API_KEY
TTS_VOICE=                       # optional; provider voice id. Used only when the team leaves Narrator on "Auto"

# App
ADMIN_TOKEN=change-me            # protects /admin
MAX_JOBS_PER_HOUR=30             # global
MAX_JOBS_PER_USER_PER_DAY=5      # production (Railway) uses 10
MAX_JOBS_PER_DAY=200             # global daily budget cap ("high demand" when hit)
MAX_CONCURRENT_JOBS=2
DATA_DIR=./data                  # /data in Docker

# Research (C19): Brave Search API key for finding problem statistics (optional)
BRAVE_API_KEY=

# Deploy tuning (containers report the host CPU count)
RENDER_CONCURRENCY=          # Remotion render workers; set to ~vCPUs on small plans
RENDER_FPS=                  # 30 halves render time; default 60
JOB_TIMEOUT_MS=              # default 600000 (10 min)
FFMPEG_THREADS=              # cap x264 threads in containers (host core count leaks in)
RENDER_FRAME_TIMEOUT_MS=     # per-frame render timeout (default 30000)
OFFTHREAD_CACHE_MB=          # cap Remotion video frame cache
STEP_TIMEOUT_MS=             # per demo step timeout (default 10000)
STRIPE_PAYMENT_LINK=
# Landing page (all optional; unset = hidden)
PILOT_PARTNER_ENABLED=false
ORGANIZER_LINE=
ORGANIZER_URL=
# Part of ORGANIZER_LINE that ORGANIZER_URL links (e.g. one event's name). Empty = the whole line is the link.
ORGANIZER_LINK_TEXT=
# Set by hand from the Stripe dashboard (not in our DB)
TRACTION_PAID_COUNT=
TRACTION_COLLECTED_USD=
TRACTION_ORGANIZER_USD=
TRACTION_ORGANIZER_RECEIVED=false
# How many paying customers are hackathon organizers (default 1 once received). 2+ shows "including N hackathon organizers".
TRACTION_ORGANIZERS=
# Builder count as reported by the team (e.g. 5+). Unset = DB count of distinct IPs, which undercounts shared networks.
TRACTION_BUILDERS=
# Finished job the form's "Fast test" button opens instantly (preloaded example, no new run). "off" hides it.
FAST_TEST_JOB_ID=1zB8JuKN
BUILD_LOG_URL=
